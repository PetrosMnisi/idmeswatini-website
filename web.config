<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows / IIS hosting: same protection as .htaccess (Apache, LiteSpeed). -->
<configuration>
  <system.webServer>
    <defaultDocument><files><clear /><add value="index.html" /><add value="index.php" /></files></defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="app" /><add segment="inc" /><add segment="database" /><add segment="private_docs" /><add segment="_backup" /><add segment="_drafts" /><add segment="_to_delete" /><add segment="Claude outputs" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" /><add fileExtension=".key" allowed="false" /><add fileExtension=".txt" allowed="false" />
          <add fileExtension=".md" allowed="false" /><add fileExtension=".bak" allowed="false" /><add fileExtension=".tgz" allowed="false" />
          <add fileExtension=".zip" allowed="false" /><add fileExtension=".log" allowed="false" /><add fileExtension=".py" allowed="false" /><add fileExtension=".json" allowed="false" /><add fileExtension=".ini" allowed="false" /><add fileExtension=".sh" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" /><add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" /><remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
